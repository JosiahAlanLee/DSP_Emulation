#X connect 8 0 9 1;
#X connect 1 0 10 0;
#X connect 9 0 10 1;
#X connect 10 0 11 0;
#X restore 220 160 pd HIPASS;
#X obj 340 135 == 2;
#X obj 220 190 +~;
#N canvas 80 80 500 500 LP2RES 0;
