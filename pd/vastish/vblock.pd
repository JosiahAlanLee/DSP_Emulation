#N canvas 40 40 1100 700 12;
#X text 20 10 vblock <name> <voice-id> : one VAST-style DSP function slot. type 0 = NONE (bypass);
#X obj 20 40 inlet~;
#X obj 200 40 vctl \$1 \$2;
#X obj 320 40 r vast-\$1-b;
#X obj 450 40 r vast-\$1-type;
#X obj 450 70 == 0;
#X obj 20 100 *~ 1;
#N canvas 80 80 500 500 LOPASS 0;
#X text 20 10 1-pole lowpass. A=cutoff (note#);
#X obj 20 40 inlet~;
#X obj 120 40 inlet~;
#X obj 220 40 inlet;
#X obj 320 40 inlet;
#X obj 320 70 switch~;
#X obj 20 120 clip~ -20 135;
#X obj 20 148 mtof~;
#X obj 20 176 clip~ 5 20000;
#X obj 20 204 lop~;
#X obj 20 460 outlet~;
#X connect 4 0 5 0;
#X connect 2 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 1 0 9 0;
#X connect 8 0 9 1;
#X connect 9 0 10 0;
#X restore 20 160 pd LOPASS;
#X obj 140 135 == 1;
#X obj 20 190 +~;
#N canvas 80 80 500 500 HIPASS 0;
#X text 20 10 1-pole highpass. A=cutoff (note#);
#X obj 20 40 inlet~;
#X obj 120 40 inlet~;
